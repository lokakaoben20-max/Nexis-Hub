# Copie ce fichier en .env et remplis les valeurs réelles (jamais commité, voir .gitignore).

# Bot Telegram
BOT_TOKEN=
ADMIN_TELEGRAM_ID=
MINI_APP_URL=

# Mode de démarrage du bot : "polling" (défaut, dev quotidien, aucun tunnel
# nécessaire) ou "webhook" (nécessite un tunnel HTTPS public actif — ngrok ou
# Cloudflare Tunnel — et les variables WEBHOOK_* ci-dessous).
BOT_RUN_MODE=polling

# --- Webhook (utilisé uniquement si BOT_RUN_MODE=webhook) ---
# URL publique HTTPS du tunnel, SANS le chemin (ex: https://xxxx.ngrok-free.app).
# Change à chaque relance d'un tunnel ngrok gratuit : à remettre à jour ici
# à chaque session locale avant de démarrer le bot en mode webhook.
WEBHOOK_URL=
WEBHOOK_PATH=/webhook
# Secret vérifié sur chaque requête entrante (en-tête
# X-Telegram-Bot-Api-Secret-Token, comparaison en temps constant). Obligatoire
# en mode webhook — même pattern que les clés BACKEND_API_KEY_* :
#   python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET_TOKEN=
# Host/port d'écoute du serveur local (le tunnel doit pointer vers ce port)
WEBHOOK_LISTEN_HOST=127.0.0.1
WEBHOOK_LISTEN_PORT=8002

# URL du backend V5 que le bot appelle
BACKEND_BASE_URL=http://127.0.0.1:8000

# Clés de service du backend V5 (en-tête X-API-Key) : UNE PAR CANAL. La clé dit
# au backend quel canal appelle ; un canal n'agit jamais au nom d'un autre.
# 32 caractères au moins, deux canaux n'ont jamais la même. Pour en générer une :
#   python -c "import secrets; print(secrets.token_hex(32))"
# L'ancienne clé unique BACKEND_API_KEY n'existe plus : si elle est encore dans
# ton .env, renomme-la en BACKEND_API_KEY_TELEGRAM (même valeur), sinon le
# backend, le bot et la Mini App refusent de démarrer.
#
# Bot Telegram et Mini App (même canal). Obligatoire, la même pour le backend,
# le bot et la Mini App.
BACKEND_API_KEY_TELEGRAM=
# Service WhatsApp (clients seulement). Laisse vide tant que ce service ne
# tourne pas : le backend refuse alors tout appel WhatsApp.
BACKEND_API_KEY_WHATSAPP=

# Redis : étapes en cours du bot (inscriptions, missions, devis) et broker Celery.
# docker compose up -d démarre l'instance locale. Le bot refuse de démarrer sans.
REDIS_URL=redis://localhost:6379/0

# Backend V5 : connexion à Postgres (docker compose up -d démarre l'instance locale)
DATABASE_URL=postgresql+psycopg://nexis_user:nexis_password@localhost:5432/nexis_hub

# --- Application mobile (API publique, backend/app/public.py) ---
# Nom d'utilisateur du bot, pour le lien « ouvrir Telegram » de la connexion.
NEXIS_BOT_USERNAME=
# Version minimale de l'application acceptée (en dessous : réponse 426).
NEXIS_APP_MIN_VERSION=1.0.0
