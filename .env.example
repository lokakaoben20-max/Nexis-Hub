# Exemple sans identifiants réels ni secrets. Copier en .env puis renseigner uniquement
# les variables nécessaires à chaque processus. Ne jamais committer .env.

# --- Bot Telegram ---
BOT_TOKEN=
# Mini App (URL complète, utilisée dans les boutons Telegram).
MINI_APP_URL=
# polling (défaut) ou webhook.
BOT_RUN_MODE=
# En développement, l'absence de cette variable sélectionne developpement.
APP_ENV=

# --- API backend ---
# Adresse locale par défaut dans le code : http://127.0.0.1:8000.
BACKEND_BASE_URL=
# Clé Telegram partagée par backend, bot et Mini App : 32 caractères au minimum.
# Générer avec : python -c "import secrets; print(secrets.token_hex(32))"
BACKEND_API_KEY_TELEGRAM=
# Facultative tant que le service WhatsApp ne tourne pas. Clé distincte, 32 caractères minimum.
BACKEND_API_KEY_WHATSAPP=
# Clés historiques ignorées comme identité ; si non vide, refus hors développement.
BACKEND_API_KEY=
# Code de connexion à l'application, clé secrète d'au moins 32 caractères hors développement.
# Générer avec : python -c "import secrets; print(secrets.token_hex(32))"
APP_CODE_HMAC_KEY=

# --- Postgres et Redis ---
# Valeurs de connexion de l'instance docker-compose.yml.
DATABASE_URL=
# Par défaut : redis://localhost:6379/0.
REDIS_URL=

# --- Paiements ---
# Valeur disponible dans le code : simulation. Interdite en APP_ENV=production.
PAYMENT_GATEWAY=
# Obligatoires hors développement ; frais de collecte et de versement.
COLLECTION_FEE_RATE=
PAYOUT_FEE_RATE=
# Les trois réglages ci-dessous existent pour USD et CDF (ex. PAYOUT_MINIMUM_USD).
PAYOUT_FEE_FIXED_USD=
PAYOUT_FEE_FIXED_CDF=
PAYOUT_MINIMUM_USD=
PAYOUT_MINIMUM_CDF=
PAYOUT_AUTO_LIMIT_USD=
PAYOUT_AUTO_LIMIT_CDF=

# --- Chiffrement et présence ---
# En développement, le backend choisit le dossier var/fichiers si vide.
FILES_DIR=
# Obligatoire hors développement : clé Fernet encodée en base64 (32 octets).
# Générer avec : python -m backend.app.fichiers
FILES_ENCRYPTION_KEY=
# Clé secrète d'au moins 32 caractères, nécessaire à la vérification de présence.
# Générer avec : python -c "import secrets; print(secrets.token_hex(32))"
PRESENCE_CODE_KEY=

# Uvicorn : ne définir que derrière un proxy de confiance.
FORWARDED_ALLOW_IPS=

# --- Application mobile ---
NEXIS_BOT_USERNAME=
# Défaut dans le code : 1.0.0.
NEXIS_APP_MIN_VERSION=

# --- Webhook Telegram (utilisé si BOT_RUN_MODE=webhook) ---
WEBHOOK_URL=
# Défauts dans le code : /webhook, 127.0.0.1, 8002.
WEBHOOK_PATH=
WEBHOOK_LISTEN_HOST=
WEBHOOK_LISTEN_PORT=
# Défaut dans le code : 120 secondes ; 0 désactive la surveillance.
WEBHOOK_WATCH_INTERVAL_SECONDS=
WEBHOOK_SECRET_TOKEN=

# --- Compatibilité et tests uniquement ---
# Ne confère pas de rôle admin. Vide en développement ; toute valeur non vide
# est refusée hors développement. Gérer les rôles avec backend.app.admins.
ADMIN_TELEGRAM_ID=
# Ces deux variables ne servent qu'à configurer les tests backend.
NEXIS_TEST_BACKEND_DB=
NEXIS_TEST_POSTGRES_URL=
