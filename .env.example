# Copie ce fichier en .env et remplis les valeurs réelles (jamais commité, voir .gitignore).

# Bot Telegram
BOT_TOKEN=
ADMIN_TELEGRAM_ID=
MINI_APP_URL=

# URL du backend V5 que le bot appelle
BACKEND_BASE_URL=http://127.0.0.1:8000

# Clé partagée entre le bot et le backend V5 (en-tête X-API-Key). Génère une
# valeur aléatoire longue, la même des deux côtés : le backend refuse de
# démarrer une requête authentifiée sans elle, et le bot ne peut plus lui
# parler sans. Exemple pour en générer une :
#   python -c "import secrets; print(secrets.token_hex(32))"
BACKEND_API_KEY=

# Backend V5 : connexion à Postgres (docker compose up -d démarre l'instance locale)
DATABASE_URL=postgresql+psycopg://nexis_user:nexis_password@localhost:5432/nexis_hub
